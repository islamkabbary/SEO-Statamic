{
    "name": "islamkabbary/seo-statamic",
    "description": "SilaSEO — in-house SEO toolkit for Statamic: meta/OG/Twitter, canonical, hreflang, JSON-LD schema, sitemap, redirects, 404 monitor, content analysis, internal-link suggestions, and IndexNow.",
    "type": "statamic-addon",
    "license": "proprietary",
    "keywords": ["statamic", "statamic-addon", "seo"],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "statamic/cms": "Required by the Statamic bridge — provided by the host Statamic site (^4 | ^5 | ^6).",
        "khaled.alshamaa/ar-php": "Improved Arabic content analysis (readability, normalization)."
    },
    "autoload": {
        "psr-4": {
            "SilaSeo\\Core\\": "packages/core/src/",
            "SilaSeo\\Laravel\\": "packages/laravel/src/",
            "SilaSeo\\Statamic\\": "packages/statamic/src/"
        },
        "files": [
            "packages/laravel/src/helpers.php",
            "packages/statamic/src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SilaSeo\\Core\\Tests\\": "packages/core/tests/",
            "SilaSeo\\Laravel\\Tests\\": "packages/laravel/tests/",
            "SilaSeo\\Statamic\\Tests\\": "packages/statamic/tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SilaSeo\\Laravel\\SilaSeoServiceProvider",
                "SilaSeo\\Statamic\\ServiceProvider"
            ],
            "aliases": {
                "Seo": "SilaSeo\\Laravel\\Facades\\Seo"
            }
        },
        "statamic": {
            "name": "SilaSeo",
            "description": "In-house SEO toolkit for Statamic."
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    }
}