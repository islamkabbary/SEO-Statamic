{
    "name": "silaseo/statamic",
    "description": "In-house SEO toolkit for the Statamic fleet.",
    "type": "statamic-addon",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "statamic/cms": "^4.0 || ^5.0 || ^6.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "suggest": {
        "khaled.alshamaa/ar-php": "Arabic content analysis: readability, harakat/alef normalization, slug transliteration."
    },
    "autoload": {
        "psr-4": {
            "SilaSeo\\Core\\": "packages/core/src/",
            "SilaSeo\\Laravel\\": "packages/laravel/src/",
            "SilaSeo\\Statamic\\": "src/"
        },
        "files": [
            "packages/laravel/src/helpers.php",
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "SilaSeo\\Core\\Tests\\": "packages/core/tests/",
            "SilaSeo\\Laravel\\Tests\\": "packages/laravel/tests/",
            "SilaSeo\\Statamic\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SilaSeo\\Statamic\\ServiceProvider",
                "SilaSeo\\Laravel\\SilaSeoServiceProvider"
            ],
            "aliases": {
                "Seo": "SilaSeo\\Laravel\\Facades\\Seo"
            }
        },
        "statamic": {
            "name": "SilaSeo",
            "slug": "silaseo",
            "description": "In-house SEO toolkit for Statamic."
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
