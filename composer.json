{
    "name": "silaseo/monorepo",
    "description": "SilaSEO — reusable in-house SEO toolkit for the Statamic fleet (monorepo dev root).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "silaseo/core": "@dev",
        "silaseo/laravel": "@dev"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0",
        "phpunit/phpunit": "^10.5"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*"
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "SilaSeo\\Core\\Tests\\": "packages/core/tests/",
            "SilaSeo\\Laravel\\Tests\\": "packages/laravel/tests/",
            "SilaSeo\\Statamic\\": "packages/statamic/src/",
            "SilaSeo\\Statamic\\Tests\\": "packages/statamic/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}