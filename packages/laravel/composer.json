{
    "name": "silaseo/laravel",
    "description": "Laravel bridge for SilaSEO: request-scoped meta service, HasSeo trait, route registry, redirects, and head rendering.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        "silaseo/core": "@dev",
        "illuminate/support": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^10.0 || ^11.0 || ^12.0 || ^13.0",
        "illuminate/view": "^10.0 || ^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "SilaSeo\\Laravel\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "SilaSeo\\Laravel\\SilaSeoServiceProvider"
            ],
            "aliases": {
                "Seo": "SilaSeo\\Laravel\\Facades\\Seo"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}